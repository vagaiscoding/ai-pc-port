-/// Two console waves of 64 lanes (four host waves of 32), and one and a
-/// half (the second wave's high half missing).
-const GROUPS: [u32; 3] = [128, 96, 64];
-
-#[test]
-fn ballots_span_both_halves_of_the_wave() {
